# ==========================================
# CampusCare Frontend - Vercel Environment Variables
# ==========================================

# URL of your Render backend (e.g., https://campuscare-backend.onrender.com)
VITE_API_URL=https://your-backend-app.onrender.com

# Supabase Client Configuration (Frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google Gemini API Key (Direct Client-Side Fallback for Voice Transcription)
VITE_GEMINI_API_KEY=your-gemini-api-key-here
