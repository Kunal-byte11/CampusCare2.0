# ==========================================
# CampusCare Backend - Render Environment Variables
# ==========================================

PORT=5000
JWT_SECRET=campuscare_ltce_jwt_secure_key_2026

# Vercel Frontend URL (e.g., https://campuscare.vercel.app)
CLIENT_URL=https://your-frontend-app.vercel.app

# Supabase Project Configuration (https://supabase.com/dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Agora RTC Video Call Credentials
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-certificate

# Google Gemini API Key (Dual-Engine LLM and Multimodal Audio)
GEMINI_API_KEY=your-gemini-api-key
